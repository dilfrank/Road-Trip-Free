# Copy to .env.local. Server-only secrets; never use NEXT_PUBLIC_ prefixes.
OPENAI_API_KEY=
OPENAI_MODEL=
AMAP_WEB_KEY=
# Keep disabled until authentication and persistent request quotas are added.
ALLOW_PUBLIC_TRIP_API=false

# JS API credentials: localhost development only; use a security proxy in production.
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=
